# ---- Application ---------------------------------------------------------
APP_NAME=Metering Billing Engine
APP_VERSION=1.0.0
DEBUG=True

# ---- Database (Postgres; the +psycopg driver is required) ----------------
# Local option: docker compose up -d db, then use the URL below.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/billing

# ---- Stripe (test mode only; both optional so the app boots without them) -
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:8000/success
STRIPE_CANCEL_URL=http://localhost:8000/cancel

# ---- Background job ------------------------------------------------------
# How often (seconds) the Stripe reconciliation loop runs. 0 disables it.
RECONCILE_INTERVAL_SECONDS=86400
